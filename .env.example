# Copiază fișierul în .env.local (local) sau pune valorile în Vercel → Settings → Environment Variables.

# Afișate în pagină (telefon, link WhatsApp, e-mail de contact). Numărul în format internațional.
WHATSAPP_NUMBER=+40700000000
CONTACT_EMAIL=contact@exemplu.ro

# Trimiterea e-mailurilor (doar pe server). Pentru Gmail: SMTP_PASS este o „parolă de aplicație”
# de 16 caractere (Cont Google → Securitate → Verificare în doi pași → Parole pentru aplicații).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=adresa-ta@gmail.com
SMTP_PASS=
# Expeditorul afișat. La Gmail trebuie să fie aceeași adresă ca SMTP_USER.
MAIL_FROM="Arcada <adresa-ta@gmail.com>"
# Unde ajung solicitările noi (implicit SMTP_USER).
LEAD_INBOX=adresa-ta@gmail.com
# Adresa publică a site-ului, apare în e-mailul de confirmare.
SITE_URL=https://arcada.vercel.app
